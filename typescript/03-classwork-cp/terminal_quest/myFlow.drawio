                <mxCell id="lbl_in_back" value="&lt;b&gt;&lt;font color=&quot;#cc0066&quot; size=&quot;3&quot;&gt;6. คืนค่า userInput = &quot;GOTO_HOTEL&quot;&lt;/font&gt;&lt;/b&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;" parent="e_in_back" vertex="1" connectable="0">
