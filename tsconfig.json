{
  "compilerOptions": {
    // Environment setup & latest features
    // ตั้งค่าเวอร์ชันและสิ่งแวดล้อม

    //บอกว่าโปรเจกต์นี้สามารถใช้ "คลังคำสั่ง (Library)" เวอร์ชันล่าสุดของ JavaScript ได้เลย ไม่ต้องกังวลว่าคำสั่งใหม่ๆ จะรันไม่ได้
    "lib": ["ESNext"],

    //บอกว่าเป้าหมายในการแปลงโค้ด (Target) ว่าจะให้แปลงออกมาเป็น JavaScript เวอร์ชันไหน 
    "module": "Preserve",

    //สั่งให้ระบบมองว่าแต่ละไฟล์ .ts แยกออกจากกันเป็นสัดส่วน (Module) เวลาเราไปเขียนโค้ดเรียกใช้ข้ามไฟล์กัน ระบบจะได้เข้าใจและจัดการได้อย่างถูกต้อง
    "moduleDetection": "force",

    //บอกว่าเราจะใช้ JSX (JavaScript XML) ในโปรเจกต์นี้ และให้แปลง JSX เป็นรูปแบบที่ React เข้าใจได้
    "jsx": "react-jsx",
    
    //บอกว่าเราจะใช้ JavaScript ร่วมกับ TypeScript ได้ (เช่น ไฟล์ .js หรือ .jsx) และให้ระบบเข้าใจและตรวจสอบโค้ดเหล่านั้นด้วย
    "allowJs": true,

    //บอกให้ระบบรู้ว่าเรากำลังใช้ Bun นะ เพื่อให้เครื่องมือช่วยพิมพ์คำสั่ง (Auto-complete) ของ Bun โผล่ขึ้นมาเวลาเราเขียนโค้ดครับ
    "types": ["bun"],

    // Bundler mode
    // วิธีมัดรวมไฟล์และการแปลงโค้ด

    //บอกให้ระบบใช้วิธีค้นหาไฟล์และมัดรวมไฟล์ตามมาตรฐานของเครื่องมือยุคใหม่ (เช่น Bun หรือ Vite) ซึ่งฉลาดและทำงานเร็ว
    "moduleResolution": "bundler",

    //อนุญาตให้เราเขียนคำสั่งดึงไฟล์ข้ามกัน (Import) โดยระบุชื่อลงท้ายด้วย .ts ตรงๆ ได้เลย
    "allowImportingTsExtensions": true,

    //บังคับให้การดึงโค้ดข้ามไฟล์มีความตรงไปตรงมา ไม่ให้ระบบแอบแปลงคำสั่งดึงไฟล์เองตามใจชอบ
    "verbatimModuleSyntax": true,

    // Output control
    // การควบคุมผลลัพธ์การแปลงโค้ด
    "noEmit": true,

    // Best practices
    // การตั้งค่าเพื่อให้โค้ดมีคุณภาพและปลอดภัยมากขึ้น

    // บังคับให้ TypeScript ตรวจสอบโค้ดอย่างเข้มงวดมากขึ้น เช่น ห้ามใช้ตัวแปรที่ไม่ได้ประกาศ, ห้ามเรียกใช้ตัวแปรที่อาจเป็น undefined, และอื่นๆ เพื่อช่วยลดข้อผิดพลาดในโค้ด
    "strict": true,

    // สั่งให้ข้ามการเข้าไปตรวจจับผิดในโค้ดของคนอื่น (ที่เราโหลดมาใช้) ตรวจเฉพาะโค้ดที่เราเขียนเองก็พอ จะได้ประหยัดเวลารัน
    "skipLibCheck": true,

    // ในคำสั่งเงื่อนไขแบบ switch-case ถ้าเราลืมเขียนคำสั่ง break; เพื่อให้มันหยุดทำงาน TypeScript จะร้องเตือนทันทีว่าคุณอาจจะลืมนะ
    "noFallthroughCasesInSwitch": true,

    //ป้องกันไม่ให้เราเผลอไปดึงข้อมูลใน Array (รายการ) ลำดับที่ไม่มีอยู่จริง ถ้ามีความเสี่ยงมันจะเตือนทันที
    "noUncheckedIndexedAccess": true,

    //าจะเขียนโค้ดทับฟังก์ชันเดิมของคลาสแม่ (Override) ต้องพิมพ์บอกให้ชัดเจน เพื่อไม่ให้เผลอไปเขียนทับโดยไม่ตั้งใจ
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    // การตั้งค่าที่เข้มงวดขึ้น (ปิดโดยค่าเริ่มต้น)

    // ป้องกันไม่ให้เราประกาศตัวแปรหรือฟังก์ชันที่ไม่ได้ใช้งาน ถ้าเราเผลอประกาศแล้วไม่ใช้ TypeScript จะเตือนทันที
    "noUnusedLocals": false,

    // ป้องกันไม่ให้เราสร้างฟังก์ชันหรือเมธอดที่มีพารามิเตอร์แต่ไม่ได้ใช้งาน ถ้าเราเผลอสร้างแล้วไม่ใช้ TypeScript จะเตือนทันที
    "noUnusedParameters": false,

    // ป้องกันไม่ให้เราเข้าถึงคุณสมบัติ (Property) ของอ็อบเจ็กต์ที่ถูกประกาศด้วย Index Signature โดยตรง 
    // ถ้าเราพยายามเข้าถึง TypeScript จะเตือนทันที
    "noPropertyAccessFromIndexSignature": false
  }
}
