                    <mxGeometry x="240" y="50" width="270" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="m_init" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;i = 0&lt;br&gt;sum = 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;arcSize=20;" parent="m1" vertex="1">
