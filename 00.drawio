    <diagram id="diag_5" name="5. 4-Colors Blueprint">
        <mxGraphModel dx="352" dy="412" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="1920" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p5_note" value="* ตัวอย่างผังงานแบบประหยัด: ใช้เฉพาะกล่องสี่เหลี่ยม (Process) และข้าวหลามตัด (Decision) เท่านั้น&#10;* แยก 4 สีตามเกณฑ์ระเบียบวินัย: เขียว (Keyword), แดง (Type), น้ำเงิน (Name/Op/Val), ดำ (Syntax/กรอบ)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Courier New;fontColor=#2ecc71;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="120" y="20" width="850" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p5_legend" value="&lt;b&gt;4-COLOR CODING STANDARD&lt;/b&gt;&lt;hr&gt;&lt;br&gt;&lt;font color=&quot;#27ae60&quot;&gt;■ สีเขียว (Keywords):&lt;/font&gt; function, let, const, return, YES, NO&lt;br&gt;&lt;font color=&quot;#e74c3c&quot;&gt;■ สีแดง (Types):&lt;/font&gt; : string, : number, : boolean, : void&lt;br&gt;&lt;font color=&quot;#2980b9&quot;&gt;■ สีน้ำเงิน (Name/Op/Num):&lt;/font&gt; ชื่อตัวแปร, เครื่องหมาย (+, -, &amp;lt;, ===), ตัวเลข&lt;br&gt;&lt;font color=&quot;#ffffff&quot;&gt;■ สีดำ (Syntax/Frame):&lt;/font&gt; กรอบสี่เหลี่ยม, ข้าวหลามตัด, วงเล็บ ( ), ปีกกา { }, ;" style="rounded=0;whiteSpace=wrap;html=1;arcSize=0;fillColor=#1e1e1e;strokeColor=#4a4a4a;fontColor=#ffffff;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;spacingRight=14;fontSize=12;fontFamily=Courier New;" parent="1" vertex="1">
                    <mxGeometry x="720" y="80" width="390" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="p5_box1" value="&lt;font color=&quot;#27ae60&quot;&gt;function&lt;/font&gt; &lt;font color=&quot;#2980b9&quot;&gt;countEven&lt;/font&gt;&lt;font color=&quot;#000000&quot;&gt;(&lt;/font&gt;&lt;font color=&quot;#2980b9&quot;&gt;nums&lt;/font&gt;&lt;font color=&quot;#e74c3c&quot;&gt;: number[]&lt;/font&gt;&lt;font color=&quot;#000000&quot;&gt;):&lt;/font&gt; &lt;font color=&quot;#e74c3c&quot;&gt;number&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#27ae60&quot;&gt;let&lt;/font&gt; &lt;font color=&quot;#2980b9&quot;&gt;count&lt;/font&gt;&lt;font color=&quot;#e74c3c&quot;&gt;: number&lt;/font&gt; &lt;font color=&quot;#2980b9&quot;&gt;= 0&lt;/font&gt;&lt;font color=&quot;#000000&quot;&gt;;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#27ae60&quot;&gt;let&lt;/font&gt; &lt;font color=&quot;#2980b9&quot;&gt;i&lt;/font&gt;&lt;font color=&quot;#e74c3c&quot;&gt;: number&lt;/font&gt; &lt;font color=&quot;#2980b9&quot;&gt;= 0&lt;/font&gt;&lt;font color=&quot;#000000&quot;&gt;;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=2;fontSize=13;fontFamily=Courier New;fillColor=#ffffff;fontColor=#000000;" parent="1" vertex="1">
