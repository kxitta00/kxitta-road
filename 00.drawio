                <mxCell id="m_add" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;sum = sum + nums[i]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;arcSize=20;" parent="m1" vertex="1">
