    <diagram id="sum_diagram" name="5. sum-array.ts (Accumulator Loop)">
        <mxGraphModel dx="1142" dy="481" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
